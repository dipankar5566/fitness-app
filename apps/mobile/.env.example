EXPO_PUBLIC_API_URL=http://localhost:3011
# Sentry DSN is a public identifier, not a secret - leave blank to disable crash reporting/analytics locally.
EXPO_PUBLIC_SENTRY_DSN=
# Google Cloud OAuth Web client ID (not the Android client) - its audience is what the API verifies
# ID tokens against (apps/api's GOOGLE_WEB_CLIENT_ID must be the SAME value).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

{
  "name": "@fitness-app/api",
  "description": "NestJS API: guest auth, food search/logging, offline sync, exercises/programs, AI meal parsing + coach, barcode lookup.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@fitness-app/shared": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "multer": "^2.5.0",
    "openai": "^7.57.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsc-watch": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
